@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using AspireApp1.StateStore
@using AspireApp1.Web.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<StateStoreDbContext> DbFactory
@inject IConfiguration Configuration
@inject ILogger<Home> Logger

<PageTitle>AspireApp1 – Demo Dashboard</PageTitle>

<h1>AspireApp1 – Demo Dashboard</h1>
<p class="lead text-muted mb-4">
    En Aspire-baserad mikrotjänstdemonstration med distribuerad telemetri, processflödesvisualisering och worker-kedjor.
</p>
<div class="alert alert-secondary py-2 px-3 mb-4">
    <strong>Aktiv StateStore DB:</strong>
    <span class="ms-1 badge @GetDbProviderBadgeClass(_dbProviderDisplay)">@_dbProviderDisplay</span>
    <span class="ms-2 text-muted small">@_dbProviderDetail</span>
</div>

<!-- Quick actions -->
<div class="row g-3 mb-5">
    <div class="col-md-4">
        <div class="card h-100 border-primary">
            <div class="card-body">
                <h5 class="card-title">
                    <span class="bi bi-play-circle-fill me-2" aria-hidden="true" style="color:#0d6efd;"></span>Starta ett flöde
                </h5>
                <p class="card-text text-muted small">
                    Utlös ett multi-steg worker-flöde (WS1→WS2→WS3) och se status i realtid.
                </p>
                <a href="/flowdemo" class="btn btn-primary btn-sm">Flödesutlösare →</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-success">
            <div class="card-body">
                <h5 class="card-title">
                    <span class="bi bi-diagram-3-fill me-2" aria-hidden="true" style="color:#198754;"></span>Spåra ett flöde
                </h5>
                <p class="card-text text-muted small">
                    Sök på TraceId, CorrelationId eller SpanId och visualisera hela anropskedjan.
                </p>
                <a href="/processflow" class="btn btn-success btn-sm">Processflöde →</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-warning">
            <div class="card-body">
                <h5 class="card-title">
                    <span class="bi bi-bug me-2" aria-hidden="true" style="color:#ffc107;"></span>Utlös felscenarier
                </h5>
                <p class="card-text text-muted small">
                    Anropa tjänster som avsiktligt returnerar fel — observera spridningen i telemetrin.
                </p>
                <a href="/errorcall" class="btn btn-warning btn-sm me-1">Felscenario 1 →</a>
                <a href="/errorcall2" class="btn btn-outline-warning btn-sm">Felscenario 2 →</a>
            </div>
        </div>
    </div>
</div>

<!-- Architecture overview -->
<div class="card mb-4">
    <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
        <span>Tjänstarkitektur &amp; tjänstehälsa</span>
        <small class="text-muted">@($"Hälsa auto-uppdateras var {AutoRefreshSettings.IntervalSeconds}:e sekund") · <a href="/insights">Levande beroendediagram och hälsohistorik →</a></small>
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2 align-items-center justify-content-center">
            <div class="text-center">
                <div class="badge bg-primary fs-6 px-3 py-2">Web Frontend</div>
                <div class="text-muted small mt-1">Blazor Server</div>
                <div class="small mt-1">
                    <span class="@GetArchitectureHealthBadgeClass("webfrontend")">@GetArchitectureHealthText("webfrontend")</span>
                </div>
            </div>
            <span class="text-muted fs-4">↕</span>
            <div class="text-center">
                <div class="badge bg-secondary fs-6 px-3 py-2">ApiService</div>
                <div class="text-muted small mt-1">Weather &amp; Forecast</div>
                <div class="small mt-1">
                    <span class="@GetArchitectureHealthBadgeClass("apiservice")">@GetArchitectureHealthText("apiservice")</span>
                </div>
            </div>
            <span class="text-muted fs-4">↔</span>
            <div class="text-center">
                <div class="badge bg-secondary fs-6 px-3 py-2">ApiServiceForecast</div>
                <div class="text-muted small mt-1">Forecast + queue</div>
                <div class="small mt-1">
                    <span class="@GetArchitectureHealthBadgeClass("apiserviceforecast")">@GetArchitectureHealthText("apiserviceforecast")</span>
                </div>
            </div>
            <span class="text-muted fs-4">↔</span>
            <div class="text-center">
                <div class="badge bg-info text-dark fs-6 px-3 py-2">WorkerService 1</div>
                <div class="text-muted small mt-1">Job consumer</div>
                <div class="small mt-1">
                    <span class="@GetArchitectureHealthBadgeClass("workerservice1")">@GetArchitectureHealthText("workerservice1")</span>
                </div>
            </div>
            <span class="text-muted fs-4">→</span>
            <div class="text-center">
                <div class="badge bg-info text-dark fs-6 px-3 py-2">WorkerService 2</div>
                <div class="text-muted small mt-1">Chain step 2</div>
                <div class="small mt-1">
                    <span class="@GetArchitectureHealthBadgeClass("workerservice2")">@GetArchitectureHealthText("workerservice2")</span>
                </div>
            </div>
            <span class="text-muted fs-4">→</span>
            <div class="text-center">
                <div class="badge bg-info text-dark fs-6 px-3 py-2">WorkerService 3</div>
                <div class="text-muted small mt-1">Chain step 3</div>
                <div class="small mt-1">
                    <span class="@GetArchitectureHealthBadgeClass("workerservice3")">@GetArchitectureHealthText("workerservice3")</span>
                </div>
            </div>
        </div>
        <p class="text-muted small text-center mt-2 mb-0">
            WorkerService&nbsp;4 övervakar tjänsterna periodiskt via deras /health-endpoint. Alla tjänster skriver telemetri till StateStore-databasen.
        </p>
        <div class="d-flex flex-wrap gap-2 justify-content-center mt-2">
            <span class="badge bg-success">✅ OK</span>
            <span class="badge bg-warning text-dark">⚠️ Varning</span>
            <span class="badge bg-danger">❌ Error</span>
            <span class="badge bg-secondary">ℹ️ Ej övervakad</span>
        </div>
    </div>
</div>

<!-- Live stats -->
<div class="card">
    <div class="card-header fw-semibold">Tillståndslagret – Live statistik</div>
    <div class="card-body">
        @if (_statsLoaded)
        {
            <div class="row g-3 text-center">
                <div class="col-6 col-md-3">
                    <div class="fs-3 fw-bold text-primary">@_jobCount</div>
                    <div class="text-muted small">Jobbposter</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="fs-3 fw-bold text-success">@_flowRunCount</div>
                    <div class="text-muted small">Flödeskörningar</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="fs-3 fw-bold text-info">@_spanCount</div>
                    <div class="text-muted small">Span-poster</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="fs-3 fw-bold text-warning">@_healthCheckCount</div>
                    <div class="text-muted small">Hälsokontroller</div>
                </div>
            </div>
            <div class="text-center mt-3">
                <a href="/processflow" class="btn btn-outline-primary btn-sm me-1">Utforska ett flöde i Processflöde →</a>
                <a href="/insights" class="btn btn-outline-secondary btn-sm">📊 Trender och insikter →</a>
            </div>
        }
        else
        {
            <div class="text-muted"><span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Laddar statistik…</div>
        }
    </div>
</div>

<div class="card mt-4">
    <div class="card-header fw-semibold">Senaste körningar</div>
    <div class="card-body">
        @if (_latestRuns.Count == 0)
        {
            <div class="text-muted small">Inga körningar registrerade ännu.</div>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2 mb-3">
                <span class="badge bg-primary">Pågår: @_runningCount</span>
                <span class="badge bg-success">Klar: @_completedCount</span>
                <span class="badge bg-danger">Fel: @_failedCount</span>
                <span class="badge bg-secondary">Väntar: @_waitingCount</span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Flöde</th>
                            <th>Status</th>
                            <th>Steg</th>
                            <th>Tjänst</th>
                            <th>Start</th>
                            <th>Spårning</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var run in _latestRuns)
                        {
                            <tr>
                                <td class="small">@run.FlowName</td>
                                <td>
                                    <span class="badge @GetStatusBadge(run.Status)" title="@GetStatusDescription(run)">@run.Status</span>
                                    <span class="visually-hidden">@GetStatusDescription(run)</span>
                                </td>
                                <td class="small">Steg @run.CurrentStep/@run.TotalSteps</td>
                                <td class="small">@run.CurrentService</td>
                                <td class="small text-muted">@run.StartedAt.ToString("HH:mm:ss")</td>
                                <td class="small">
                                    @if (!string.IsNullOrWhiteSpace(run.TraceId))
                                    {
                                        <a href="/processflow?traceId=@Uri.EscapeDataString(run.TraceId)"
                                           title="@($"Visa TraceId {run.TraceId} i Processflöde")">Visa trace →</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Inget TraceId</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-3">
                <a class="btn btn-outline-secondary btn-sm" href="/flowruns">Visa alla körningar →</a>
            </div>
        }
    </div>
</div>

@code {
    private bool _statsLoaded;
    private int _jobCount;
    private int _flowRunCount;
    private int _spanCount;
    private int _healthCheckCount;
    private int _runningCount;
    private int _completedCount;
    private int _failedCount;
    private int _waitingCount;
    private bool _isDisposed;
    private string _dbProviderDisplay = "SQL Server";
    private string _dbProviderDetail = "ConnectionStrings:statestoreSqlServer";
    private List<FlowRunOverview> _latestRuns = [];
    private Dictionary<string, ServiceHealthOverview> _serviceHealthByService = new(StringComparer.OrdinalIgnoreCase);
    private System.Threading.Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        StartRefreshTimer();
    }

    private void StartRefreshTimer()
    {
        _refreshTimer?.Dispose();
        _refreshTimer = new System.Threading.Timer(
            _ => InvokeAsync(RefreshAsync),
            null,
            TimeSpan.FromSeconds(AutoRefreshSettings.IntervalSeconds),
            TimeSpan.FromSeconds(AutoRefreshSettings.IntervalSeconds));
    }

    private async Task RefreshAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var provider = StateStoreDbRegistration.ResolveProvider(Configuration);
            _dbProviderDisplay = provider == "sqlserver" ? "SQL Server" : "SQLite";
            _dbProviderDetail = GetDbProviderDetail(provider);

            _jobCount = await db.JobStates.CountAsync();
            _flowRunCount = await db.FlowRunRecords.CountAsync();
            _spanCount = await db.SpanRecords.CountAsync();
            _healthCheckCount = await db.ServiceHealthRecords.CountAsync();

            // Order by Id in SQL (SQLite cannot ORDER BY DateTimeOffset), then by StartedAt in memory.
            var latestFlowRuns = (await db.FlowRunRecords
                .OrderByDescending(r => r.Id)
                .Take(8)
                .ToListAsync())
                .OrderByDescending(r => r.StartedAt)
                .ToList();

            var flowRunIds = latestFlowRuns.Select(r => r.FlowRunId).ToList();
            var allSteps = flowRunIds.Count > 0
                ? await db.FlowStepRecords
                    .Where(s => flowRunIds.Contains(s.FlowRunId))
                    .ToListAsync()
                : [];

            _latestRuns = latestFlowRuns.Select(run =>
            {
                var flowState = FlowRunStateCalculator.Build(run, allSteps);

                return new FlowRunOverview
                {
                    FlowName = flowState.FlowName,
                    Status = flowState.Status,
                    CurrentStep = flowState.CurrentStep,
                    TotalSteps = flowState.TotalSteps,
                    CurrentService = flowState.CurrentService ?? "okänd",
                    TraceId = run.TraceId,
                    StartedAt = run.StartedAt
                };
            }).ToList();

            _runningCount = _latestRuns.Count(r => r.Status == "Pågår");
            _completedCount = _latestRuns.Count(r => r.Status == "Klar");
            _failedCount = _latestRuns.Count(r => r.Status == "Fel");
            _waitingCount = _latestRuns.Count(r => r.Status == "Väntar");

            var latestHealthChecks = (await db.ServiceHealthRecords
                .OrderByDescending(h => h.Id)
                .Take(2000)
                .ToListAsync())
                .OrderByDescending(h => h.CheckedAt)
                .ToList();

            _serviceHealthByService = latestHealthChecks
                .GroupBy(h => h.ServiceName)
                .Select(g => g.First())
                .Select(h => new ServiceHealthOverview
                {
                    ServiceName = h.ServiceName,
                    Status = h.IsHealthy ? "OK" : h.HttpStatusCode >= 500 ? "Error" : "Varning",
                    CheckedAt = h.CheckedAt,
                    HttpStatusCode = h.HttpStatusCode
                })
                .ToDictionary(h => h.ServiceName, StringComparer.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load state store stats on home page");
        }

        _statsLoaded = true;

        if (!_isDisposed)
        {
            StateHasChanged();
        }
    }

    private static string GetStatusBadge(string status) => status switch
    {
        "Klar" => "bg-success",
        "Fel" => "bg-danger",
        "Pågår" => "bg-primary",
        "Väntar" => "bg-secondary",
        _ => "bg-secondary"
    };

    private static string GetStatusDescription(FlowRunOverview run) =>
        $"{run.Status}. Steg {run.CurrentStep} av {run.TotalSteps}. Aktiv tjänst: {run.CurrentService}.";

    private static string GetHealthEmoji(string status) => status switch
    {
        "OK" => "✅",
        "Varning" => "⚠️",
        "Error" => "❌",
        _ => "❓"
    };

    private static string GetHealthBadgeClass(string status) => status switch
    {
        "OK" => "badge bg-success",
        "Varning" => "badge bg-warning text-dark",
        "Error" => "badge bg-danger",
        _ => "badge bg-secondary"
    };

    private string GetArchitectureHealthText(string serviceName) =>
        _serviceHealthByService.TryGetValue(serviceName, out var health)
            ? $"{GetHealthEmoji(health.Status)} {health.Status}"
            : "ℹ️ Ej övervakad";

    private string GetArchitectureHealthBadgeClass(string serviceName) =>
        _serviceHealthByService.TryGetValue(serviceName, out var health)
            ? GetHealthBadgeClass(health.Status)
            : "badge bg-secondary";

    private string GetDbProviderDetail(string provider)
    {
        if (provider == "sqlserver")
        {
            var sqlServerConnection = Configuration.GetConnectionString("statestoreSqlServer") ?? string.Empty;
            var serverPart = sqlServerConnection.Split(';', StringSplitOptions.RemoveEmptyEntries)
                .FirstOrDefault(part => part.TrimStart().StartsWith("Server=", StringComparison.OrdinalIgnoreCase));
            return serverPart is not null ? $"{serverPart} • ConnectionStrings:statestoreSqlServer" : "ConnectionStrings:statestoreSqlServer";
        }

        return "ConnectionStrings:statestore";
    }

    private static string GetDbProviderBadgeClass(string provider) => provider switch
    {
        "SQL Server" => "bg-primary",
        "SQLite" => "bg-success",
        _ => "bg-secondary"
    };

    public void Dispose()
    {
        _isDisposed = true;
        _refreshTimer?.Dispose();
    }

    private sealed class FlowRunOverview
    {
        public string FlowName { get; init; } = string.Empty;
        public string Status { get; init; } = string.Empty;
        public int CurrentStep { get; init; }
        public int TotalSteps { get; init; }
        public string CurrentService { get; init; } = string.Empty;
        public string? TraceId { get; init; }
        public DateTimeOffset StartedAt { get; init; }
    }

    private sealed class ServiceHealthOverview
    {
        public string ServiceName { get; init; } = string.Empty;
        public string Status { get; init; } = string.Empty;
        public DateTimeOffset CheckedAt { get; init; }
        public int HttpStatusCode { get; init; }
        public string Description => $"{Status} för {ServiceName} (HTTP {HttpStatusCode})";
    }
}
