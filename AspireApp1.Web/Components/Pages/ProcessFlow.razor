@page "/processflow"
@rendermode InteractiveServer
@implements IDisposable

@using AspireApp1.Web.Models
@using System.Text.RegularExpressions
@inject TraceQueryService TraceQuery
@inject FlowRestartService FlowRestartService
@inject ILogger<ProcessFlow> Logger
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Processflöde</PageTitle>

<h1>Processflöde</h1>

<p>Sök och visualisera telemetriflöden via TraceId, CorrelationId eller SpanId.</p>

<!-- Search form -->
<div class="search-panel mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label fw-semibold">Söktyp</label>
            <select class="form-select" @bind="searchType">
                <option value="traceId">TraceId</option>
                <option value="correlationId">CorrelationId</option>
                <option value="spanId">SpanId</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold">
                @if (searchType == "traceId") { <text>TraceId (32 hex), traceparent eller Aspire trace-detail URL</text> }
                else if (searchType == "correlationId") { <text>CorrelationId (GUID eller sträng)</text> }
                else { <text>SpanId (16 hexadecimala tecken)</text> }
            </label>
            <input class="form-control" type="text" @bind="searchInput" @bind:event="oninput"
                   placeholder="Ange ID..." @onkeydown="HandleKeyDown" />
        </div>
        <div class="col-md-3">
            <button class="btn btn-primary w-100" @onclick="SearchAsync" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                Sök
            </button>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(validationError))
    {
        <div class="alert alert-warning mt-2 mb-0">@validationError</div>
    }
</div>

<!-- Recent searches -->
@if (recentSearches.Count > 0 && currentTrace is null && !notFound)
{
    <div class="mb-4">
        <h6 class="text-muted">Senaste sökningar</h6>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var recent in recentSearches)
            {
                <button class="btn btn-outline-secondary btn-sm font-monospace"
                        @onclick="() => ApplyRecentSearch(recent)"
                        title="@recent.SearchType: @recent.Input">
                    <small>@recent.SearchType:</small> @TruncateId(recent.Input)
                </button>
            }
        </div>
    </div>
}

<!-- Results -->
@if (notFound)
{
    <div class="alert alert-info">
        <div><strong>Ingen träff för angivet ID.</strong></div>
        <div class="small mt-1">Tips: använd 32 tecken TraceId, hela traceparent-värdet eller URL-formatet <code>/traces/detail/&lt;traceId&gt;</code>. Prova annars CorrelationId eller SpanId.</div>
    </div>
}
else if (currentTrace is not null)
{
    <!-- Summary bar -->
    <div class="d-flex flex-wrap gap-3 align-items-center mb-3">
        <span class="badge fs-6 @GetOverallStatusBadge(currentTrace).cssClass">@GetOverallStatusBadge(currentTrace).text</span>
        <span class="text-muted small">
            @currentTrace.Spans.Count span(s) |
            @currentTrace.Spans.Select(s => s.ServiceName).Distinct().Count() tjänst(er) |
            Startade: @currentTrace.StartTime.ToString("HH:mm:ss.fff")
        </span>
        @if (currentTrace.TraceId is not null)
        {
            <button class="btn btn-outline-secondary btn-sm py-0 font-monospace small"
                    @onclick='() => CopyToClipboardAsync(currentTrace.TraceId)'
                    title="Kopiera TraceId">
                <small>TraceId: @TruncateId(currentTrace.TraceId)</small> 📋
            </button>
        }
        @if (currentTrace.CorrelationId is not null)
        {
            <button class="btn btn-outline-secondary btn-sm py-0 font-monospace small"
                    @onclick='() => CopyToClipboardAsync(currentTrace.CorrelationId)'
                    title="Kopiera CorrelationId">
                <small>CorrId: @TruncateId(currentTrace.CorrelationId)</small> 📋
            </button>
        }
        @if (_copyFeedback is not null)
        {
            <span class="text-success small">@_copyFeedback</span>
        }
    </div>

    @if (currentTrace.FlowRuns.Count > 0)
    {
        <div class="row g-3 mb-3">
            @foreach (var flow in currentTrace.FlowRuns.Take(3))
            {
                <div class="col-lg-4">
                    <div class="border rounded p-3 h-100">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong>@flow.FlowName</strong>
                            <span class="badge @GetFlowStatusBadgeClass(flow.Status)">@flow.Status</span>
                        </div>
                        <div class="small text-muted mb-1">Steg @flow.CurrentStep / @flow.TotalSteps</div>
                        <div class="progress mb-2" style="height:0.5rem;">
                            <div class="progress-bar @GetFlowProgressClass(flow.Status)"
                                 role="progressbar"
                                 style="width:@GetFlowProgressPercent(flow).ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%"
                                 aria-label="@($"Steg {flow.CurrentStep} av {flow.TotalSteps}. Status {flow.Status}.")"
                                 aria-valuemin="0"
                                 aria-valuemax="@flow.TotalSteps"
                                 aria-valuenow="@flow.CurrentStep"></div>
                        </div>
                        <div class="small">
                            <span class="fw-semibold">Aktiv tjänst:</span> @(flow.CurrentService ?? "okänd")
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (GetPrimaryFlowRunState(currentTrace) is FlowRunStateModel primaryFlow && primaryFlow.ErrorStep is not null)
    {
        <div class="alert alert-danger">
            <strong>Var fastnade det?</strong> Flödet stoppade i steg @primaryFlow.ErrorStep/@primaryFlow.TotalSteps i @(primaryFlow.CurrentService ?? "okänd tjänst").
            @if (!string.IsNullOrWhiteSpace(primaryFlow.ErrorMessage))
            {
                <div class="small mt-1">Orsak: @primaryFlow.ErrorMessage</div>
            }
            @if (primaryFlow.LastSuccessStep is not null)
            {
                <div class="small">Senaste lyckade steg: @primaryFlow.LastSuccessStep/@primaryFlow.TotalSteps.</div>
            }
        </div>
    }
    else if (GetPrimaryFlowRunState(currentTrace) is FlowRunStateModel inProgressFlow && inProgressFlow.Status == "Pågår")
    {
        <div class="alert alert-primary">
            <strong>Pågående:</strong> steg @inProgressFlow.CurrentStep/@inProgressFlow.TotalSteps i @(inProgressFlow.CurrentService ?? "okänd tjänst").
            @if (inProgressFlow.LastSuccessStep is not null)
            {
                <span class="small ms-1">(senaste lyckade: @inProgressFlow.LastSuccessStep/@inProgressFlow.TotalSteps)</span>
            }
        </div>
    }
    else if (GetPrimaryFlowRunState(currentTrace) is FlowRunStateModel waitingFlow && waitingFlow.Status == "Väntar")
    {
        <div class="alert alert-secondary">
            <strong>Väntar:</strong> nästa steg är @waitingFlow.CurrentStep/@waitingFlow.TotalSteps i @(waitingFlow.CurrentService ?? "okänd tjänst").
        </div>
    }

    @if (GetPrimaryFlowRunState(currentTrace) is FlowRunStateModel restartableFlow)
    {
        <div class="restart-panel mb-3">
            <button class="btn btn-outline-danger btn-sm" @onclick="() => RestartFlowAsync(restartableFlow)" disabled="@_isRestarting">
                @if (_isRestarting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>Återstartar…</span>
                }
                else
                {
                    <span class="bi bi-arrow-clockwise me-1" aria-hidden="true"></span>
                    <span>Återstarta flöde</span>
                }
            </button>
            <span class="text-muted small ms-2">Skapar en ny körning av samma flödestyp om en tidigare körning fastnat.</span>
            @if (!string.IsNullOrWhiteSpace(_restartFeedback))
            {
                <div class="alert alert-success py-2 px-3 mt-2 mb-0">@_restartFeedback</div>
            }
            @if (!string.IsNullOrWhiteSpace(_restartError))
            {
                <div class="alert alert-danger py-2 px-3 mt-2 mb-0">@_restartError</div>
            }
        </div>
    }

    <!-- View toggle + filters -->
    <div class="d-flex flex-wrap gap-3 align-items-center mb-3">
        <div class="btn-group" role="group" aria-label="Vyval">
            <button type="button" class="btn @(viewMode == "steps" ? "btn-primary" : "btn-outline-primary")" @onclick='() => viewMode = "steps"'>Stegvy</button>
            <button type="button" class="btn @(viewMode == "gantt" ? "btn-primary" : "btn-outline-primary")" @onclick='() => viewMode = "gantt"'>Tidslinjevy</button>
        </div>

        <div class="d-flex align-items-center gap-2">
            <label class="form-label mb-0 fw-semibold">Tjänst:</label>
            <select class="form-select form-select-sm" style="width:auto;" @bind="serviceFilter">
                <option value="">Alla</option>
                @foreach (var svc in GetServiceNames())
                {
                    <option value="@svc">@svc</option>
                }
            </select>
        </div>

        <div class="d-flex align-items-center gap-2">
            <label class="form-label mb-0 fw-semibold">Status:</label>
            <select class="form-select form-select-sm" style="width:auto;" @bind="statusFilter">
                <option value="">Alla</option>
                @foreach (var s in Enum.GetNames<SpanStatus>())
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>

        <span class="text-muted small ms-auto">Visar @VisibleSpans.Count av @currentTrace.Spans.Count span(s)</span>
    </div>

    @if (viewMode == "steps")
    {
        <div class="step-controls mb-3">
            <div class="btn-group btn-group-sm" role="group" aria-label="Detaljkontroller">
                <button type="button" class="btn btn-outline-primary" @onclick="ExpandAllDetails">Öppna alla detaljer</button>
                <button type="button" class="btn btn-outline-primary" @onclick="CollapseAllDetails">Stäng alla detaljer</button>
            </div>
            <div class="btn-group btn-group-sm" role="group" aria-label="Grenkontroller">
                <button type="button" class="btn btn-outline-secondary" @onclick="ExpandAllBranches">Expandera alla grenar</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="CollapseAllBranches">Kollapsa alla grenar</button>
            </div>
            <span class="badge bg-light text-dark border">Tider i stegvy visas i sekunder</span>
        </div>
    }

    @if (viewMode == "steps")
    {
        <div class="step-tree">
            @foreach (var span in GetRootSpans(VisibleSpans))
            {
                @RenderSpanTree(span, VisibleSpans, 0)
            }
        </div>
    }
    else
    {
        @RenderGanttView(VisibleSpans)
    }
}

@code {
    [SupplyParameterFromQuery(Name = "traceId")] private string? QueryTraceId { get; set; }
    [SupplyParameterFromQuery(Name = "correlationId")] private string? QueryCorrelationId { get; set; }
    [SupplyParameterFromQuery(Name = "spanId")] private string? QuerySpanId { get; set; }

    private string searchType = "traceId";
    private string searchInput = string.Empty;
    private string viewMode = "steps";
    private string serviceFilter = string.Empty;
    private string statusFilter = string.Empty;
    private bool isLoading;
    private bool notFound;
    private string? validationError;
    private TraceModel? currentTrace;
    private string? selectedSpanId;
    private string? highlightSpanId;
    private HashSet<string> highlightedSpanIds = [];
    private HashSet<string> openSpanDetailIds = [];
    private HashSet<string> collapsedSpanIds = [];
    private bool _isRestarting;
    private string? _restartFeedback;
    private string? _restartError;
    private string? _copyFeedback;
    private System.Threading.Timer? _copyFeedbackTimer;
    private bool _initialParamSearchDone;

    // Recent searches (stored in-memory per circuit, max 5)
    private List<(string SearchType, string Input)> recentSearches = [];

    protected override async Task OnParametersSetAsync()
    {
        // Auto-search only once per navigation to avoid re-triggering on every re-render
        if (_initialParamSearchDone) return;

        if (!string.IsNullOrWhiteSpace(QueryTraceId))
        {
            _initialParamSearchDone = true;
            searchType = "traceId";
            searchInput = QueryTraceId;
            await SearchAsync();
        }
        else if (!string.IsNullOrWhiteSpace(QueryCorrelationId))
        {
            _initialParamSearchDone = true;
            searchType = "correlationId";
            searchInput = QueryCorrelationId;
            await SearchAsync();
        }
        else if (!string.IsNullOrWhiteSpace(QuerySpanId))
        {
            _initialParamSearchDone = true;
            searchType = "spanId";
            searchInput = QuerySpanId;
            await SearchAsync();
        }
    }

    public void Dispose()
    {
        _copyFeedbackTimer?.Dispose();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        validationError = null;
        notFound = false;
        selectedSpanId = null;
        highlightSpanId = null;
        highlightedSpanIds = [];
        openSpanDetailIds = [];
        collapsedSpanIds = [];
        _restartFeedback = null;
        _restartError = null;
        currentTrace = null;

        if (string.IsNullOrWhiteSpace(searchInput))
        {
            validationError = "Ange ett ID att söka på.";
            return;
        }

        var trimmedInput = searchInput.Trim();
        var normalizedInput = trimmedInput;
        string? extractedSpanId = null;

        if (searchType == "traceId")
        {
            if (!TraceQueryService.TryNormalizeTraceIdInput(trimmedInput, out normalizedInput, out extractedSpanId))
            {
                validationError = "TraceId måste vara 32 hexadecimala tecken, ett W3C traceparent-värde, eller en Aspire trace-detail URL.";
                return;
            }
        }

        if (searchType == "spanId" && !SpanIdRegex.IsMatch(trimmedInput))
        {
            validationError = "SpanId måste vara exakt 16 hexadecimala tecken.";
            return;
        }

        isLoading = true;
        try
        {
            TraceModel? trace = searchType switch
            {
                "traceId" => await TraceQuery.GetByTraceIdAsync(normalizedInput),
                "correlationId" => await TraceQuery.GetByCorrelationIdAsync(normalizedInput),
                "spanId" => await TraceQuery.GetBySpanIdAsync(normalizedInput),
                _ => null
            };

            if (trace is null && searchType == "traceId")
            {
                trace = await TraceQuery.GetByCorrelationIdAsync(normalizedInput);
            }

            if (trace is null && searchType == "traceId" && extractedSpanId is not null)
            {
                trace = await TraceQuery.GetBySpanIdAsync(extractedSpanId);
            }

            if (trace is null || trace.Spans.Count == 0)
            {
                notFound = true;
            }
            else
            {
                currentTrace = trace;
                AddRecentSearch(searchType, trimmedInput);

                if (searchType == "spanId")
                {
                    highlightSpanId = trimmedInput.ToLowerInvariant();
                    highlightedSpanIds = [highlightSpanId];
                }
                else if (searchType == "traceId" && extractedSpanId is not null)
                {
                    highlightSpanId = extractedSpanId;
                    highlightedSpanIds = [highlightSpanId];
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while searching for trace. SearchType={SearchType} Input={Input}", searchType, searchInput);
            notFound = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void AddRecentSearch(string type, string input)
    {
        recentSearches.RemoveAll(r => r.SearchType == type && r.Input == input);
        recentSearches.Insert(0, (type, input));
        if (recentSearches.Count > 5)
        {
            recentSearches.RemoveAt(recentSearches.Count - 1);
        }
    }

    private async Task ApplyRecentSearch((string SearchType, string Input) recent)
    {
        searchType = recent.SearchType;
        searchInput = recent.Input;
        await SearchAsync();
    }

    private async Task RestartFlowAsync(FlowRunStateModel flow)
    {
        _isRestarting = true;
        _restartFeedback = null;
        _restartError = null;

        try
        {
            var restartResult = await FlowRestartService.RestartFlowAsync(flow.FlowRunId, CancellationToken.None);
            if (!restartResult.IsSuccess)
            {
                _restartError = restartResult.ErrorMessage ?? "Kunde inte återstarta flödet.";
                return;
            }

            var newFlowRunId = restartResult.FlowRunId;
            var newTraceId = restartResult.TraceId;
            var newCorrelationId = restartResult.CorrelationId;

            if (!string.IsNullOrWhiteSpace(newTraceId))
            {
                searchType = "traceId";
                searchInput = newTraceId;
                await SearchAsync();
            }
            else if (!string.IsNullOrWhiteSpace(newCorrelationId))
            {
                searchType = "correlationId";
                searchInput = newCorrelationId;
                await SearchAsync();
            }

            _restartFeedback = $"Ny körning startad{(string.IsNullOrWhiteSpace(newFlowRunId) ? "." : $": {newFlowRunId}")}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Kunde inte återstarta flöde. flowRunId={FlowRunId}", flow.FlowRunId);
            _restartError = "Återstart misslyckades. Försök igen.";
        }
        finally
        {
            _isRestarting = false;
        }
    }

    private async Task CopyToClipboardAsync(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            _copyFeedback = "Kopierat! ✓";
        }
        catch
        {
            _copyFeedback = "Kopiera misslyckades";
        }

        _copyFeedbackTimer?.Dispose();
        _copyFeedbackTimer = new System.Threading.Timer(_ => InvokeAsync(() =>
        {
            _copyFeedback = null;
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(2), Timeout.InfiniteTimeSpan);
    }

    private static string TruncateId(string id) =>
        id.Length > 20 ? id[..8] + "…" + id[^8..] : id;

    private List<SpanModel> VisibleSpans => GetFilteredSpans();

    private List<SpanModel> GetFilteredSpans()
    {
        if (currentTrace is null)
        {
            return [];
        }

        var spans = currentTrace.Spans.AsEnumerable();

        if (!string.IsNullOrEmpty(serviceFilter))
        {
            spans = spans.Where(s => s.ServiceName == serviceFilter);
        }

        if (!string.IsNullOrEmpty(statusFilter) && Enum.TryParse<SpanStatus>(statusFilter, out var parsedStatus))
        {
            spans = spans.Where(s => s.Status == parsedStatus);
        }

        return [.. spans.OrderBy(s => s.StartTime)];
    }

    private static IEnumerable<SpanModel> GetRootSpans(List<SpanModel> spans)
    {
        var ids = spans.Select(s => s.SpanId).ToHashSet();
        return spans.Where(s => s.ParentSpanId is null || !ids.Contains(s.ParentSpanId)).OrderBy(s => s.StartTime);
    }

    private IEnumerable<string> GetServiceNames()
    {
        if (currentTrace is null)
        {
            return [];
        }

        return currentTrace.Spans.Select(s => s.ServiceName).Distinct().Order();
    }

    private void ToggleSpanDetails(SpanModel span)
    {
        selectedSpanId = span.SpanId;
        if (!openSpanDetailIds.Add(span.SpanId))
        {
            openSpanDetailIds.Remove(span.SpanId);
        }
    }

    private void ToggleChildren(SpanModel span)
    {
        if (!collapsedSpanIds.Add(span.SpanId))
        {
            collapsedSpanIds.Remove(span.SpanId);
        }
    }

    private void ExpandAllDetails()
    {
        openSpanDetailIds = [.. VisibleSpans.Select(s => s.SpanId)];
    }

    private void CollapseAllDetails()
    {
        openSpanDetailIds.Clear();
    }

    private void ExpandAllBranches()
    {
        collapsedSpanIds.Clear();
    }

    private void CollapseAllBranches()
    {
        collapsedSpanIds = [.. VisibleSpans
            .Where(s => VisibleSpans.Any(c => c.ParentSpanId == s.SpanId))
            .Select(s => s.SpanId)];
    }

    private static string GetStepStatusText(SpanStatus status) => status switch
    {
        SpanStatus.OK => "Klar",
        SpanStatus.Warning => "Varning",
        SpanStatus.Error => "Fel",
        SpanStatus.InProgress => "Pågår",
        _ => "Okänd"
    };

    private static string GetStepStatusBadgeClass(SpanStatus status) => status switch
    {
        SpanStatus.OK => "bg-success",
        SpanStatus.Warning => "bg-warning text-dark",
        SpanStatus.Error => "bg-danger",
        SpanStatus.InProgress => "bg-primary",
        _ => "bg-secondary"
    };

    private string GetOffsetFromTraceStartText(SpanModel span)
    {
        if (currentTrace is null)
        {
            return "Start +0.00 sek";
        }

        var seconds = (span.StartTime - currentTrace.StartTime).TotalSeconds;
        return $"Start +{seconds:F2} sek";
    }

    private static (string cssClass, string text) GetOverallStatusBadge(TraceModel trace)
    {
        if (trace.OverallStatus == SpanStatus.Error)
        {
            var errorSpan = trace.Spans.Find(s => s.Status == SpanStatus.Error);
            return ("bg-danger", $"Flöde misslyckades – Fel i steg {errorSpan?.OperationName ?? "okänt"}");
        }

        return trace.OverallStatus switch
        {
            SpanStatus.OK => ("bg-success", "Flöde slutfört – OK"),
            SpanStatus.Warning => ("bg-warning text-dark", "Flöde slutfört med varningar"),
            SpanStatus.InProgress => ("bg-info text-dark", "Flöde pågår"),
            _ => ("bg-secondary", "Status okänd")
        };
    }

    private static string GetStatusEmoji(SpanStatus status) => status switch
    {
        SpanStatus.OK => "✅",
        SpanStatus.Warning => "⚠️",
        SpanStatus.Error => "❌",
        SpanStatus.InProgress => "🔄",
        _ => "❓"
    };

    private static string GetStatusRowClass(SpanStatus status) => status switch
    {
        SpanStatus.Error => "span-row-error",
        SpanStatus.Warning => "span-row-warning",
        SpanStatus.InProgress => "span-row-progress",
        _ => string.Empty
    };

    private string GetGanttRowClass(SpanModel span, bool isHighlighted)
    {
        if (isHighlighted)
        {
            return "table-primary";
        }

        if (selectedSpanId == span.SpanId)
        {
            return "table-active";
        }

        return string.Empty;
    }

    private static string GetLogLevelClass(string level) => level.ToUpperInvariant() switch
    {
        "ERROR" or "CRITICAL" => "bg-danger bg-opacity-10",
        "WARNING" or "WARN" => "bg-warning bg-opacity-10",
        _ => "bg-light"
    };

    private static string GetLogBadgeClass(string level) => level.ToUpperInvariant() switch
    {
        "ERROR" or "CRITICAL" => "bg-danger",
        "WARNING" or "WARN" => "bg-warning text-dark",
        "INFORMATION" or "INFO" => "bg-info text-dark",
        "DEBUG" => "bg-secondary",
        _ => "bg-secondary"
    };

    private static string GetFlowStatusBadgeClass(string status) => status switch
    {
        "Klar" => "bg-success",
        "Fel" => "bg-danger",
        "Pågår" => "bg-primary",
        "Väntar" => "bg-secondary",
        _ => "bg-secondary"
    };

    private static string GetFlowProgressClass(string status) => status switch
    {
        "Klar" => "bg-success",
        "Fel" => "bg-danger",
        "Pågår" => "bg-primary",
        _ => "bg-secondary"
    };

    private static double GetFlowProgressPercent(FlowRunStateModel flow)
    {
        if (flow.TotalSteps <= 0)
        {
            return 0;
        }

        return Math.Clamp((double)flow.CurrentStep / flow.TotalSteps * 100d, 0d, 100d);
    }

    private static FlowRunStateModel? GetPrimaryFlowRunState(TraceModel trace)
    {
        return trace.FlowRuns.FirstOrDefault(f => f.ErrorStep is not null)
            ?? trace.FlowRuns.FirstOrDefault(f => f.Status == "Pågår")
            ?? trace.FlowRuns.FirstOrDefault();
    }

    private RenderFragment RenderSpanTree(SpanModel span, List<SpanModel> allSpans, int depth) => __builder =>
    {
        var children = allSpans.Where(s => s.ParentSpanId == span.SpanId).OrderBy(s => s.StartTime).ToList();
        var hasChildren = children.Count > 0;
        var isCollapsed = collapsedSpanIds.Contains(span.SpanId);
        var isDetailsOpen = openSpanDetailIds.Contains(span.SpanId);
        var isSelected = selectedSpanId == span.SpanId;
        var isHighlighted = highlightedSpanIds.Contains(span.SpanId.ToLowerInvariant());
        var rowClass = isHighlighted ? "span-row-highlight" : GetStatusRowClass(span.Status);
        var durationText = FormatDurationSeconds(span.Duration);
        var offsetText = GetOffsetFromTraceStartText(span);

        <div class="span-row @rowClass mb-2 p-2 border rounded span-row-enhanced @(isDetailsOpen ? "span-row-open" : string.Empty) @(isSelected ? "span-row-selected" : string.Empty)" style="margin-left: @(depth * 1.2)rem;">
            <div class="d-flex align-items-center gap-2 flex-wrap span-row-header">
                @if (hasChildren)
                {
                    <button class="btn btn-sm btn-outline-primary py-0 px-2" @onclick="() => ToggleChildren(span)" title="Visa/dölj underliggande spans">
                        @(isCollapsed ? $"▶ {children.Count}" : $"▼ {children.Count}")
                    </button>
                }
                <button class="btn btn-sm @(isDetailsOpen ? "btn-primary" : "btn-outline-secondary") py-0 px-2" @onclick="() => ToggleSpanDetails(span)" title="Visa/dölj detaljer">
                    @(isDetailsOpen ? "Stäng" : "Öppna")
                </button>
                <span class="badge @GetStepStatusBadgeClass(span.Status)">@GetStatusEmoji(span.Status) @GetStepStatusText(span.Status)</span>
                <strong>@span.ServiceName</strong>
                <span class="text-muted">›</span>
                <span>@span.OperationName</span>
                <small class="text-muted ms-auto">@offsetText | @durationText</small>
            </div>
            @if (!string.IsNullOrEmpty(span.ErrorMessage))
            {
                <div class="text-danger small mt-1">@span.ErrorMessage</div>
            }

            <div class="span-inline-details @(isDetailsOpen ? "open" : string.Empty)">
                @if (isDetailsOpen)
                {
                    <dl class="row mb-0 mt-2 small">
                        <dt class="col-sm-2">SpanId</dt>
                        <dd class="col-sm-10"><code>@span.SpanId</code></dd>
                        <dt class="col-sm-2">Parent</dt>
                        <dd class="col-sm-10"><code>@(span.ParentSpanId ?? "–")</code></dd>
                        <dt class="col-sm-2">Starttid</dt>
                        <dd class="col-sm-10">@span.StartTime.ToString("yyyy-MM-dd HH:mm:ss zzz") (@offsetText)</dd>
                        <dt class="col-sm-2">Varaktighet</dt>
                        <dd class="col-sm-10">@durationText</dd>
                        @if (span.HttpStatusCode.HasValue)
                        {
                            <dt class="col-sm-2">HTTP</dt>
                            <dd class="col-sm-10">@span.HttpStatusCode</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(span.ErrorMessage))
                        {
                            <dt class="col-sm-2">Fel</dt>
                            <dd class="col-sm-10 text-danger">@span.ErrorMessage</dd>
                        }
                    </dl>

                    @if (span.LogEntries.Count > 0)
                    {
                        <div class="small mt-2">
                            <strong>Loggposter:</strong>
                            @foreach (var log in span.LogEntries)
                            {
                                <div class="log-entry @GetLogLevelClass(log.Level) mt-1 p-1 rounded small">
                                    <span class="fw-semibold me-1">[@log.Timestamp.ToString("HH:mm:ss")]</span>
                                    <span class="badge @GetLogBadgeClass(log.Level) me-1">@log.Level</span>
                                    @log.Message
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        @if (!isCollapsed)
        {
            @foreach (var child in children)
            {
                @RenderSpanTree(child, allSpans, depth + 1)
            }
        }
    };

    private RenderFragment RenderGanttView(List<SpanModel> spans) => __builder =>
    {
        if (spans.Count == 0)
        {
            <p class="text-muted">Inga spans att visa.</p>
            return;
        }

        var traceStart = spans.Min(s => s.StartTime);
        var traceEnd = spans
            .Select(s => s.Duration.HasValue ? s.StartTime + s.Duration.Value : s.StartTime)
            .Max();
        var totalMs = (traceEnd - traceStart).TotalMilliseconds;
        if (totalMs <= 0)
        {
            totalMs = 1;
        }
        var totalSeconds = totalMs / 1000d;

        <div class="gantt-container" style="overflow-x: auto;">
            <table class="table table-sm table-bordered mb-0">
                <thead>
                    <tr>
                        <th style="min-width:200px;">Tjänst / Operation</th>
                        <th>Tidslinje (@totalSeconds.ToString("F2") sek totalt)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var span in spans)
                    {
                        var offsetPct = totalMs > 0 ? (span.StartTime - traceStart).TotalMilliseconds / totalMs * 100 : 0;
                        var widthPct = span.Duration.HasValue && totalMs > 0
                            ? Math.Max(0.5, span.Duration.Value.TotalMilliseconds / totalMs * 100)
                            : 0.5;
                        var barClass = span.Status switch
                        {
                            SpanStatus.Error => "bg-danger",
                            SpanStatus.Warning => "bg-warning",
                            SpanStatus.OK => "bg-success",
                            SpanStatus.InProgress => "bg-info",
                            _ => "bg-secondary"
                        };
                        var isHighlighted = highlightedSpanIds.Contains(span.SpanId.ToLowerInvariant());

                        <tr class="@GetGanttRowClass(span, isHighlighted)" @onclick="() => ToggleSpanDetails(span)" style="cursor:pointer;" title="@span.OperationName">
                            <td class="small">
                                <span>@GetStatusEmoji(span.Status)</span>
                                <strong>@span.ServiceName</strong><br />
                                <span class="text-muted">@span.OperationName</span>
                            </td>
                            <td style="position:relative; min-width:300px; height:2.5rem; padding:0;">
                                <div style="position:absolute; left:@(offsetPct.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; width:@(widthPct.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; top:25%; height:50%; border-radius:3px;"
                                     class="@barClass" title="@(span.Duration.HasValue ? $"{span.Duration.Value.TotalSeconds:F2} sek" : "okänd varaktighet")">
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    };

    private static string FormatDurationSeconds(TimeSpan? duration) =>
        duration.HasValue ? $"{duration.Value.TotalSeconds:F2} sek" : "–";

    private static readonly Regex SpanIdRegex = new(@"^[0-9a-fA-F]{16}$", RegexOptions.Compiled);
}
