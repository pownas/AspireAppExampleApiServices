@page "/flowdemo"
@rendermode InteractiveServer
@implements IDisposable
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@inject IHttpClientFactory HttpClientFactory
@inject IDbContextFactory<AspireApp1.StateStore.StateStoreDbContext> DbFactory
@inject ILogger<FlowDemo> Logger

<PageTitle>Flödesutlösare</PageTitle>

<h1>Flödesutlösare</h1>
<p class="lead text-muted">
    Utlös ett distribuerat flöde som passerar synkront och asynkront genom WorkerService&nbsp;1, 2 och 3.
    Statusen uppdateras live medan varje steg fortskrider – kopiera sedan TraceId eller CorrelationId och sök i Processflöde för att visualisera hela anropskedjan.
</p>

<!-- Architecture diagram (ASCII-art for demo) -->
<div class="card mb-4 border-0 bg-light">
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2 align-items-center justify-content-center font-monospace small">
            <span class="badge bg-primary px-2 py-1">Web → /flow/start</span>
            <span>→</span>
            <span class="badge bg-info text-dark px-2 py-1">WS1 (synkront)</span>
            <span>⇢</span>
            <span class="badge bg-info text-dark px-2 py-1">WS2 (asynkront)</span>
            <span>⇢</span>
            <span class="badge bg-info text-dark px-2 py-1">WS3 (asynkront)</span>
        </div>
        <p class="text-center text-muted small mt-2 mb-0">
            Steg 1 körs synkront i WS1. Steg 2 och 3 körs asynkront med korta fördröjningar och rapporterar tillbaka via SQLite-tillståndslagret.
        </p>
    </div>
</div>

<div class="mb-3">
    <button class="btn btn-primary btn-lg" @onclick="StartFlow" disabled="@(_isRunning || _isPolling)">
        @if (_isRunning)
        {
            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            <span>Startar…</span>
        }
        else if (_isPolling)
        {
            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            <span>Väntar på steg…</span>
        }
        else
        {
            <span class="bi bi-play-circle-fill me-1" aria-hidden="true"></span>
            <span>Starta flöde</span>
        }
    </button>
</div>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger">@_errorMessage</div>
}

@if (_flowRunId is not null)
{
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><strong>Flödeskörning</strong></span>
            <span class="badge fs-6 @GetStatusBadgeClass(_flowStatus)">
                @GetStatusEmoji(_flowStatus) @_flowStatus
            </span>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Flow Run ID</dt>
                <dd class="col-sm-9 font-monospace small">@_flowRunId</dd>
                @if (_correlationId is not null)
                {
                    <dt class="col-sm-3">Correlation ID</dt>
                    <dd class="col-sm-9 font-monospace small">@_correlationId</dd>
                }
                @if (_traceId is not null)
                {
                    <dt class="col-sm-3">Trace ID</dt>
                    <dd class="col-sm-9 font-monospace small">@_traceId</dd>
                }
            </dl>
        </div>
    </div>

    @if (_steps.Count > 0)
    {
        <table class="table table-sm table-bordered table-hover">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Steg</th>
                    <th>Tjänst</th>
                    <th>Status</th>
                    <th>Varaktighet</th>
                    <th>Fel</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var step in _steps)
                {
                    <tr class="@GetStepRowClass(step.Status)">
                        <td>@step.StepOrder</td>
                        <td>@step.StepName</td>
                        <td><span class="badge bg-secondary">@step.ServiceName</span></td>
                        <td>
                            <span>@GetStatusEmoji(step.Status)</span>
                            <span>@step.Status</span>
                        </td>
                        <td class="font-monospace small">@FormatDuration(step.StartedAt, step.CompletedAt)</td>
                        <td class="text-danger small">@step.ErrorMessage</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (_isPolling)
    {
        <div class="text-muted small mb-2">
            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            Hämtar status automatiskt var 2:a sekund…
        </div>
    }

    @if (_flowStatus is "Completed" or "Failed")
    {
        <div class="alert @(_flowStatus == "Completed" ? "alert-success" : "alert-warning") mt-2">
            <strong>@(_flowStatus == "Completed" ? "✅ Flödet är klart!" : "⚠️ Flödet avslutades med fel.")</strong>
            Sök i Processflöde för att visualisera hela anropskedjan:
            <div class="mt-2 d-flex flex-wrap gap-2">
                @if (_correlationId is not null)
                {
                    <a class="btn btn-primary btn-sm"
                       href="/processflow?correlationId=@Uri.EscapeDataString(_correlationId)">
                        <span class="bi bi-diagram-3-fill me-1" aria-hidden="true"></span>
                        Visa via Correlation ID
                    </a>
                }
                @if (_traceId is not null)
                {
                    <a class="btn btn-outline-primary btn-sm"
                       href="/processflow?traceId=@Uri.EscapeDataString(_traceId)">
                        <span class="bi bi-diagram-3-fill me-1" aria-hidden="true"></span>
                        Visa via Trace ID
                    </a>
                }
            </div>
        </div>
    }
}

@code {
    private bool _isRunning;
    private bool _isPolling;
    private string? _flowRunId;
    private string? _correlationId;
    private string? _traceId;
    private string? _flowStatus;
    private string? _errorMessage;
    private List<FlowStepDto> _steps = [];

    private System.Threading.Timer? _pollTimer;

    private async Task StartFlow()
    {
        _isRunning = true;
        _errorMessage = null;
        _flowRunId = null;
        _correlationId = null;
        _traceId = null;
        _flowStatus = null;
        _steps = [];

        try
        {
            // Use the named workerservice1 HttpClient — it has BaseAddress configured by Aspire
            // service discovery and is callable from the server side (unlike the dev-proxy URL).
            var http = HttpClientFactory.CreateClient("workerservice1");
            var resp = await http.PostAsync("/flow/start", content: null);
            if (!resp.IsSuccessStatusCode)
            {
                _errorMessage = $"Kunde inte starta flöde: HTTP {(int)resp.StatusCode}";
                return;
            }

            using var doc = await resp.Content.ReadFromJsonAsync<JsonDocument>();
            if (doc is null)
            {
                _errorMessage = "Ogiltigt svar från flödesstart.";
                return;
            }

            var root = doc.RootElement;
            _flowRunId = root.TryGetProperty("flowRunId", out var fid) ? fid.GetString() : null;
            _correlationId = root.TryGetProperty("correlationId", out var cid) ? cid.GetString() : null;
            _traceId = root.TryGetProperty("traceId", out var tid) ? tid.GetString() : null;
            _flowStatus = "Running";

            if (_flowRunId is not null)
            {
                StartPolling();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error starting flow");
            _errorMessage = $"Fel: {ex.Message}";
        }
        finally
        {
            _isRunning = false;
        }
    }

    private void StartPolling()
    {
        _isPolling = true;
        _pollTimer?.Dispose();
        _pollTimer = new System.Threading.Timer(
            _ => InvokeAsync(PollStatus),
            state: null,
            dueTime: TimeSpan.FromSeconds(1),
            period: TimeSpan.FromSeconds(2));
    }

    private async Task PollStatus()
    {
        if (_flowRunId is null) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var flowRun = await db.FlowRunRecords
                .FirstOrDefaultAsync(r => r.FlowRunId == _flowRunId);
            if (flowRun is null) return;

            _flowStatus = flowRun.Status.ToString();
            if (flowRun.CorrelationId is not null) _correlationId = flowRun.CorrelationId;
            if (flowRun.TraceId is not null) _traceId = flowRun.TraceId;

            var steps = await db.FlowStepRecords
                .Where(s => s.FlowRunId == _flowRunId)
                .OrderBy(s => s.StepOrder)
                .ToListAsync();

            _steps = steps.Select(s => new FlowStepDto
            {
                StepName = s.StepName,
                ServiceName = s.ServiceName,
                StepOrder = s.StepOrder,
                Status = s.Status.ToString(),
                StartedAt = s.StartedAt,
                CompletedAt = s.CompletedAt,
                ErrorMessage = s.ErrorMessage,
            }).ToList();

            if (_flowStatus is "Completed" or "Failed")
            {
                _isPolling = false;
                _pollTimer?.Dispose();
                _pollTimer = null;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error polling flow status");
        }
    }

    private static string GetStatusEmoji(string? status) => status switch
    {
        "Completed" => "✅",
        "Failed" => "❌",
        "Running" => "🔄",
        "Pending" => "⏳",
        _ => "❓"
    };

    private static string GetStatusBadgeClass(string? status) => status switch
    {
        "Completed" => "bg-success",
        "Failed" => "bg-danger",
        "Running" => "bg-primary",
        _ => "bg-secondary"
    };

    private static string GetStepRowClass(string? status) => status switch
    {
        "Failed" => "table-danger",
        "Running" => "table-primary",
        "Completed" => "table-success",
        _ => ""
    };

    private static string FormatDuration(DateTimeOffset? start, DateTimeOffset? end)
    {
        if (start is null) return "–";
        if (end is null) return "pågår…";
        var d = end.Value - start.Value;
        return d.TotalSeconds >= 1 ? $"{d.TotalSeconds:F1}s" : $"{d.TotalMilliseconds:F0}ms";
    }

    public void Dispose()
    {
        _pollTimer?.Dispose();
    }

    private record FlowStepDto
    {
        public string StepName { get; init; } = "";
        public string ServiceName { get; init; } = "";
        public int StepOrder { get; init; }
        public string Status { get; init; } = "";
        public DateTimeOffset? StartedAt { get; init; }
        public DateTimeOffset? CompletedAt { get; init; }
        public string? ErrorMessage { get; init; }
    }
}
